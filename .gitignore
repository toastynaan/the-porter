# Godot 4+ specific ignores
.godot/
/android/
# Blender autosaves and backups
*.blend1
*.blend@
.DS_Store
override.cfg
# Review renders: regenerate with tools/review.sh
art/_review/*
!art/_review/.gdignore
# Textures as downloaded: tools/build/tex_fetch.py fetches them again
art/_src/
# Playtest screen recordings: far over GitHub's 100 MB limit
docs/*.mov
__pycache__/
