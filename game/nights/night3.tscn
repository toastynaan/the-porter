[node name="crypt" type="Marker3D" parent="Marks" groups=["bell_spawn"]]
transform = Transform3D(6.12323e-17, 0, -1, 0, 1, 0, 1, 0, 6.12323e-17, 23.5, 0.05, -31.5)
editor_description = "Where a death after the quiet save before the crypt puts you."

[node name="Director" type="Node" parent="."]
script = ExtResource("director_gd")
night = 3
start_dose = 30.0
start_flags = Array[StringName]([&"bread_warned"])

[node name="Wake" type="Node" parent="Director" node_paths=PackedStringArray("wake_at", "tower", "gate")]
script = ExtResource("wake_gd")
phase = 6
bell = &"start"
due = 17.25
wake_at = NodePath("../../Marks/WakeCell")
tower = NodePath("../../BellTower")
gate = NodePath("../../AbbeyGate")

[node name="Supper" type="Node" parent="Director" node_paths=PackedStringArray("seat", "seat_duty", "bread", "osric", "thomas")]
script = ExtResource("supper_gd")
phase = 0
due = 17.25
duty = "Supper in the refectory, at the supper bell"
seat = NodePath("../../Marks/PorterSeat")
seat_duty = NodePath("../../Duties/SupperSeat")
bread = NodePath("../../Duties/Bread")
osric = NodePath("../../Brothers/Osric")
thomas = NodePath("../../Brothers/Thomas")

[node name="Gate" type="Node" parent="Director" node_paths=PackedStringArray("gate", "cole", "cole_off", "relieve", "shut_gate", "bar_duty", "ledger")]
script = ExtResource("gate_gd")
phase = 1
duty = "After supper: take the gate from Cole, shut and bar it, open the ledger"
gate = NodePath("../../AbbeyGate")
cole = NodePath("../../People/Cole")
cole_off = NodePath("../../Marks/ColeOff")
relieve = NodePath("../../Duties/RelieveCole")
shut_gate = NodePath("../../Duties/ShutGate")
bar_duty = NodePath("../../Duties/BarGate")
ledger = NodePath("../../Duties/Ledger")

[node name="Knocks" type="Node" parent="Director" node_paths=PackedStringArray("lane_start", "lane_leave", "porch", "inside", "prior_from", "grate", "bar_duty", "open_gate", "shut_gate", "ledger", "beds", "gate")]
script = ExtResource("visits_gd")
phase = 2
can_doze = true
duty = "Keep the gate: answer the knocks"
visitors = Array[ExtResource("visitor_gd")]([ExtResource("walter")])
visitor_scene = ExtResource("visitor_npc")
prior_visitor = ExtResource("prior")
lane_start = NodePath("../../Marks/LaneStart")
lane_leave = NodePath("../../Marks/LaneLeave")
porch = NodePath("../../Marks/Porch")
inside = NodePath("../../Marks/Inside")
prior_from = NodePath("../../Marks/PriorFrom")
grate = NodePath("../../Duties/Grate")
bar_duty = NodePath("../../Duties/BarGate")
open_gate = NodePath("../../Duties/OpenGate")
shut_gate = NodePath("../../Duties/ShutGate")
ledger = NodePath("../../Duties/Ledger")
beds = NodePath("../../Duties/GuestBeds")
gate = NodePath("../../AbbeyGate")

[node name="Bell" type="Node" parent="Director" node_paths=PackedStringArray("rope", "tower")]
script = ExtResource("bell_gd")
phase = 3
due = 24.0
can_doze = true
duty = "Ring the bell for Matins"
rope = NodePath("../../Duties/BellRope")
tower = NodePath("../../BellTower")

[node name="Choir" type="Node" parent="Director" node_paths=PackedStringArray("choir", "dead_brother")]
script = ExtResource("choir_gd")
phase = 3
bell = &"matins"
duty = "Count the brothers at Matins"
choir = NodePath("../../Marks/Choir")
dead_brother = NodePath("../../Brothers/Stranger/Look")

[node name="Round" type="Node" parent="Director" node_paths=PackedStringArray("stops", "stalker", "walk_end", "doorways")]
script = ExtResource("round_gd")
phase = 4
duty = "The lantern round: the stores door, the chapter house door, the sanctuary lamp"
stops = NodePath("../../Duties/RoundStops")
stalker = NodePath("../../Stalker")
walk_end = NodePath("../../Stalk/WalkEnd")
doorways = NodePath("../../Stalk/Doorways")

[node name="Crypt" type="Node" parent="Director" node_paths=PackedStringArray("light", "hunter", "crypt")]
script = ExtResource("crypt_gd")
phase = 4
bell = &"crypt"
quiet = true
light = NodePath("../../CryptLight")
hunter = NodePath("../../Hunter")
crypt = NodePath("../../Marks/CryptFoot")

[node name="Chase" type="Node" parent="Director" node_paths=PackedStringArray("hunter", "stalker", "oven", "blockers", "thomas", "rescue_porter", "rescue_thomas")]
script = ExtResource("chase_gd")
phase = 4
hunter = NodePath("../../Hunter")
stalker = NodePath("../../Stalker")
oven = NodePath("../../Abbey/Navigation/SouthRange/HidingSpots/Oven")
blockers = NodePath("../../Stalk/Blockers")
thomas = NodePath("../../Brothers/Thomas")
rescue_porter = NodePath("../../Marks/RescuePorter")
rescue_thomas = NodePath("../../Marks/RescueThomas")

[node name="SmallHours" type="Node" parent="Director" node_paths=PackedStringArray("bench", "tower", "gate_lamp")]
script = ExtResource("small_gd")
phase = 7
due = 30.0
can_doze = true
duty = "Watch the gate until Lauds"
bench = NodePath("../../GateBench")
tower = NodePath("../../BellTower")
gate_lamp = NodePath("../../Lamps/GateLamp")

[node name="Dawn" type="Node" parent="Director" node_paths=PackedStringArray("gate", "cole", "cole_off", "cole_gate", "hand_over", "cell", "keys_on_hook", "keys_moved", "sleep")]
script = ExtResource("dawn_gd")
phase = 5
due = 30.0
duty = "At Lauds: give the gate to Cole, and sleep"
gate = NodePath("../../AbbeyGate")
cole = NodePath("../../People/Cole")
cole_off = NodePath("../../Marks/ColeOff")
cole_gate = NodePath("../../Marks/ColeGate")
hand_over = NodePath("../../Duties/HandOver")
cell = NodePath("../../Marks/DawnCell")
cell_radius = 2.5
keys_on_hook = NodePath("../../Marks/KeysOnHook")
keys_moved = NodePath("../../Duties/KeysMoved")
sleep = NodePath("../../Duties/Sleep")
