[node name="Bridge" type="Marker3D" parent="RideCues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -90, 0, 44.5)
script = ExtResource("cue_gd")
lines = PackedStringArray("Carter: Over the brook, and your lane's the next turning. Nearly there.")
pace = 2.2
