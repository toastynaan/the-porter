[node name="Night0" instance=ExtResource("base")]
editor_description = "Night 0, the Cross Keys (design doc, Night 0): the road in through Aldgate on the carter's wagon, the barred gate and Mab, the evening at the inn and the lane, the curfew bell, the squint scare, and the killing seen from the window. It inherits night_base.tscn."

[node name="Clock" parent="."]
start_hour = 16.5
seconds_per_hour = 150.0

[node name="Weather" parent="."]
kind = 1
clears_at = 19.0

[node name="Daylight" parent="."]
editor_description = "The road in begins in the last grey daylight, brighter than the abbey's dusks: the day goes as the wall comes nearer."
day_sky = 1.0
day_ambient = 1.5
day_sun = 0.7

[node name="Cat" parent="."]
editor_description = "The abbey's cat keeps to the abbey tonight: the porter isn't in it."
from_hour = 99.0

