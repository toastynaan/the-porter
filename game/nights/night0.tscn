[node name="Night0" instance=ExtResource("base")]
editor_description = "Night 0, the Cross Keys (design doc, Night 0): the road in through Aldgate on the carter's wagon, the barred gate and Mab, the evening at the inn and the lane, the curfew bell, the squint scare, and the killing seen from the window. It inherits night_base.tscn."

