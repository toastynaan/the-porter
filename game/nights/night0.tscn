[node name="RideCues" type="Node3D" parent="."]
editor_description = "What happens on the road in as the wagon passes each cue (RideCue): lines, a talk someone starts, a sound, a new pace, a stop. Each counts from the nearest point of the road; move them to move the moment. Lines and talks wait while the porter talks, and are dropped once the wagon is `keep` metres past; a cue with cut_in breaks off his talk instead (the traveller greeting the warden at Aldgate). The cart with the body is RideBeat's own: as it comes close the traveller breaks off (\"Whoa. Look at that.\")."

[node name="Fields" type="Marker3D" parent="RideCues" node_paths=PackedStringArray("talker")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -210, 0, 44.5)
script = ExtResource("cue_gd")
keep = 40.0
talk = ExtResource("n0_traveller_road")
talker = NodePath("../../Traveller")

[node name="WhiteChapel" type="Marker3D" parent="RideCues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -193, 6, 62)
script = ExtResource("cue_gd")
lines = PackedStringArray("(The bell of the white chapel, ringing for Vespers.)", "Carter: Vespers already. Hup! We'll be in before they shut the gate.")
sound = ExtResource("sfx_bell")
volume_db = -4.0
keep = 25.0

[node name="Whoa" type="Marker3D" parent="RideCues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -174, 0, 44.5)
script = ExtResource("cue_gd")
lines = PackedStringArray("Carter: Easy, easy. Let him by.")
keep = 12.0

[node name="Wall" type="Marker3D" parent="RideCues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -134, 0, 44.5)
script = ExtResource("cue_gd")
lines = PackedStringArray("(The city wall, black against the sky. A lantern burns in Aldgate's arch.)")
pace = 2.0
keep = 12.0

[node name="Aldgate" type="Marker3D" parent="RideCues" node_paths=PackedStringArray("watchers", "talker", "inspector")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -121.5, 0, 44.4)
script = ExtResource("cue_gd")
editor_description = "The wagon stops and the traveller breaks off whatever he was saying to greet the warden (cut_in). The warden walks up with the last of the lines, holds his lantern up to the porter's face and talks to him (talk: warden.tres), and walks back to his place (parting_lines). Sets n0_past_aldgate as the wagon goes on."
lines = PackedStringArray("Traveller: Evening, warden. God keep the gate.", "Warden: In or out, carter? We shut at the curfew bell, and we open for no one after it.", "Carter: In, warden. Two for the city.", "Warden: Let's have a look at you, then.")
pace = 3.2
hold = 1.0
watchers = [NodePath("../../RoadFolk/Warden")]
cut_in = true
inspector = NodePath("../../RoadFolk/Warden")
talk = ExtResource("n0_warden")
talker = NodePath("../../RoadFolk/Warden")
parting_lines = PackedStringArray("Warden: You're good. Go on, and God go with you.")
flag = &"n0_past_aldgate"

[node name="Shutters" type="Marker3D" parent="RideCues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -100, 4, 44)
script = ExtResource("cue_gd")
lines = PackedStringArray("(Shutters bang closed above you as the wagon passes, one after another.)")
sound = ExtResource("sfx_shutters")
keep = 15.0

