[node name="Lane" type="Marker3D" parent="RideCues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -42, 0, 28)
script = ExtResource("cue_gd")
lines = PackedStringArray("Traveller: That wall's your abbey. God keep you, brother. Bar your door at night.")
keep = 25.0

