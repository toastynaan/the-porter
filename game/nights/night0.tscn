script = ExtResource("cue_gd")
lines = PackedStringArray("(A woman in a doorway watches you go by. She crosses herself.)")
keep = 12.0
watchers = [NodePath("../../RoadFolk/Townswoman")]

[node name="Dog" type="Marker3D" parent="RideCues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -80, 0, 50.5)
script = ExtResource("cue_gd")
lines = PackedStringArray("Traveller: They bar their doors early, this side of the wall. Since the pilgrims started going missing.")
sound = ExtResource("sfx_dog")
volume_db = -3.0
keep = 25.0

[node name="Turn" type="Marker3D" parent="RideCues"]
