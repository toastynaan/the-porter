[node name="Precinct" parent="." instance=ExtResource("pr_model")]
editor_description = "The whole precinct outside the church and the ranges: its wall, its ground, the porter's cell, guesthouse, charnel house, infirmary and mill. Built by tools/build/env_precinct.py from the wall pieces and ground blocks of abbey.tscn, outer_court.tscn and graveyard_infirmary.tscn (rebuild it after moving one); no collision of its own."
