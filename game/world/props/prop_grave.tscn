[node name="Grave" type="Node3D"]
editor_description = "A grave, 2 m long (along X, head to the west), 0.9 m wide (tools/build/prop_abbey_yard.py). Model shows one of six by where the grave stands: a grassed mound with a wooden cross leaning; a mound with no marker; a sunken one, its turf fallen in; a stone slab cracked across; a small discoid stone, tilted; fresh dark earth (set its pick to choose). The hidden Block is its collision: the mound only, walked over; the markers are not solid."

