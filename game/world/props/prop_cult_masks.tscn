[node name="CultMasks" type="Node3D"]
editor_description = "The cult's masks on a peg board (tools/build/prop_abbey_yard.py; night 6, the crypt passage): three long faces of pale wood with eye holes, no mouth and antlers lashed to the brow (the middle one cracked), and a black habit hung by its hood on the last peg. For a wall: the board's back is at Z = 0, 1.6 m up, 1.6 m long, and everything hangs toward +Z. No collision. The old placeholder meshes are hidden."

