[node name="Inn" type="Node3D" groups=["placeholder"]]
script = ExtResource("house_gd")
editor_description = "Placeholder: the Cross Keys, the inn opposite the gate. Timber-framed, three storeys, 12 m along the lane and 10 m deep; its street front faces -Z with the door in the middle. Inside: the taproom (hearth, counter, tables), stairs at the left back to an open loft of beds, and at the top a small room at the front right with one window toward the abbey. Lit windows are set per house (lit_windows)."

