[node name="Rooms" parent="." instance=ExtResource("rooms")]
editor_description = "The inn from within (tools/build/env_inn_rooms.py): walls' inner faces, floors, ceilings and their timbers, stairs and rails, the hearth, the counter and the casks and shelves behind it, pegs and cloaks, the porter's room. No collision: the hidden Blocks and Solids are that."

