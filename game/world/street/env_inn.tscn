[node name="Inn" type="Node3D"]
script = ExtResource("house_gd")
lit_material = ExtResource("inn_glass")
editor_description = "The Cross Keys, the inn opposite the gate: a close-studded timber house of three storeys under twin gables, 12 m along the lane and 10 m deep; its street front faces -Z with the door in the middle. Shell is the outside (tools/build/env_inn.py) and Rooms the inside (tools/build/env_inn_rooms.py); tools/build/inn_plan.py is the plan they share. Inside: the taproom (hearth, counter, tables, settles), stairs at the left back to an open loft of beds, and at the top the porter's room at the front right with the one window that is really open, toward the abbey. The hidden Blocks and Solids are its collision. Lit windows are set where the inn is placed (lit_windows); the lane's curfew puts them out."

