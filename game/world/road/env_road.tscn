[node name="Fields" parent="." instance=ExtResource("fields")]
editor_description = "The ground outside the wall: the road, its ditches, and the open fields in ridge and furrow (tools/build/env_road_fields.py). It is built in this scene's own coordinates, so it stays at the origin."

