[node name="CityWall" parent="." instance=ExtResource("city_wall")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -118, 0, 47)
editor_description = "London's wall each side of Aldgate: bastions, a fallen stretch to the north, the stair to the walk on the city side, and the causeway over the ditch (tools/build/env_city_wall.py). Built in the gate's own space, so it stands where the gate does."

[node name="Aldgate" parent="." instance=ExtResource("aldgate")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -118, 0, 47)
editor_description = "Aldgate: two round towers, the archway between them with its portcullis drawn up and its doors folded back, the chamber over it with candles lit (tools/build/env_aldgate.py). Its front (-Z) is turned to the country."

[node name="Skyline" parent="." instance=ExtResource("skyline")]
script = ExtResource("city_gd")
editor_description = "The city behind the wall: roofs and parish churches near, and far off more towers and St Paul's (tools/build/env_city_skyline.py). Built in this scene's own coordinates, so it stays at the origin. RoadCity puts the far city away near the lane, and clears the lane's greybox stand-ins for tonight."

