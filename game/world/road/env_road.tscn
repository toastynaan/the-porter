[node name="Road" type="Node3D" groups=["placeholder"]]
editor_description = "Placeholder: the road in on night 0 (design doc, Night 0: The road in). Grey dusk over mud and ruts: the white chapel in the fields, the city wall and Aldgate's dark arch, then close, tall streets, and the turn into the lane by the abbey gate. The wagon drives it on rails along RidePath. Only night 0 uses it."

[node name="Air" type="Node" parent="."]
script = ExtResource("air")

[node name="Fields" parent="." instance=ExtResource("fields")]
editor_description = "The ground outside the wall: the road, its ditches, and the open fields in ridge and furrow (tools/build/env_road_fields.py). It is built in this scene's own coordinates, so it stays at the origin."

[node name="Growth" parent="." instance=ExtResource("growth")]
editor_description = "Dead grass, reeds and docks on the verges, the ditch banks and the fields (tools/build/env_road_growth.py). They bend in the wind."

[node name="Backdrop" parent="." instance=ExtResource("backdrop")]
editor_description = "The horizon of the fields: far woods and hedges round their edges (tools/build/env_road_backdrop.py). Built in this scene's own coordinates, so it stays at the origin."

