[node name="WhiteChapel" instance=ExtResource("model")]
editor_description = "The white chapel in the fields outside Aldgate (night 0, the road in), with its yard: a limewashed nave and chancel, a west tower, a north porch toward the road, a walled yard with a gate, a cross and graves. The nave runs along x, the tower at -x; the road side is -z. Built by tools/build/env_white_chapel.py. Candles are lit inside for Vespers: the lights here are what they throw out through the glass."

