[gd_resource type="Resource" script_class="Visitor" format=3]

[ext_resource type="Script" path="res://game/gate/visitor.gd" id="1_visitor"]
[ext_resource type="PackedScene" path="res://game/characters/chr_walter.tscn" id="look"]
[ext_resource type="Script" path="res://game/gate/visitor_detail.gd" id="2_detail"]

[sub_resource type="Resource" id="Detail_face"]
script = ExtResource("2_detail")
part = &"face"
line = "(Oily, cheerful.)"
ledger = "oily and cheerful"

[sub_resource type="Resource" id="Detail_body"]
script = ExtResource("2_detail")
part = &"body"
line = "(Plump, in a coloured cloak.)"
ledger = "plump, in a coloured cloak"

[sub_resource type="Resource" id="Detail_box"]
script = ExtResource("2_detail")
part = &"box"
line = "(His box of relics rattles.)"
ledger = "carrying a box of relics"

[sub_resource type="Resource" id="Detail_bag"]
script = ExtResource("2_detail")
part = &"bag"
line = "(His bag smells of the incense.)"
ledger = "his bag smells of the incense"

[resource]
script = ExtResource("1_visitor")
id = &"walter"
speaker = "Walter"
look = ExtResource("look")
ledger_name = "Walter the pardoner"
greeting = "Walter again, brother, and frozen to the marrow! A bed for tonight, there's a good porter, and Walter will be no trouble to anyone."
greeting_face = "amused, brow"
answer_face = "calm, still"
details = Array[ExtResource("2_detail")]([SubResource("Detail_face"), SubResource("Detail_body"), SubResource("Detail_box"), SubResource("Detail_bag")])
flag = &"n3_walter"
question = "What's in the bag?"
answer = PackedStringArray("The bag? Linen, a clean shirt, and sweet herbs to keep the moth out.", "Walter likes to smell holy, brother. It's good for trade.")
