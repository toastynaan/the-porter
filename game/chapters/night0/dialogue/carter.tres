[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n0_carter"
text = "# DRAFT
# The carter sets the porter down in the lane by the abbey gate at dusk, night 0.
== start
Carter {weary}: (He reins in with a jolt.) Here's your abbey. Down you get, brother. I've a horse to stable before dark.
* Will you wait while I knock? -> wait
* Is the gate always shut like this? -> shut
* God keep you. -> bless

== wait
Carter {afraid, blink}: Wait? In this lane, with the light going?
(He spits over the wheel.)
Carter {wary}: No, brother. Knock all you like. I'll not be here to see it.
-> end

== shut
Carter {wary}: Couldn't say. I don't stop here.
(He jerks his head across the lane, at a lit doorway under a painted sign.)
Carter {calm}: There's the Keys, if they won't have you.
-> end

== bless
Carter {grave}: And you. You'll want Him more than I will.
-> end

== again
Carter {angry}: I said down you get. Go on with you.
(He clicks his tongue at the horse.)
-> end

== leave
Carter {calm}: Mind your bundle, brother.
"
