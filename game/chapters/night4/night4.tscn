[node name="Fog" type="Node" parent="Director" node_paths=PackedStringArray("spot", "death", "arriver", "arriver_at")]
script = ExtResource("witness_gd")
phase = 4
bell = &"fog"
quiet = true
duty = "The round: the north walk, in the fog"
spot = NodePath("../../Marks/FogSpot")
death = NodePath("../../FogDeath")
also_dead = Array[StringName]([&"died_choira"])
death_lines = PackedStringArray("(A man cries out in the fog a few steps ahead of you, and the cry stops short.)", "(Brother Wulfric lies on the flags of the walk, his old eyes open on the fog.)", "(His lantern is still rolling. It rocks to a stop against his hand, and the flame stands up again.)")
arriver = NodePath("../../Brothers/Hugh")
arriver_at = NodePath("../../Marks/HughKneels")
arriver_lines = PackedStringArray("(Steps in the fog. The prior comes out of the white, sees the body, and kneels by it without a word.)", "(When he gets up, the cuff of his sleeve is dark and wet with blood.)", "Hugh: Stand back from him, porter. And keep your hands where I can see them.")
note = &"prior_sleeve"

[node name="Guest" type="Node" parent="Director" node_paths=PackedStringArray("death", "at")]
script = ExtResource("guestdeath_gd")
phase = 4
duty = "The round: the guesthouse"
visitor = ExtResource("guest")
death = NodePath("../../GuestDeath")
at = NodePath("../../Marks/GuestDoor")
death_lines = PackedStringArray("(The guesthouse door stands open. Your guest lies across his bed, opened from the throat down, and the blood is still running off the blanket.)", "(The cuts are no beast's. Long and even, laid in rows and crossed, the same mark over and over, as if someone had been writing on him.)")
barred_lines = PackedStringArray("(The guesthouse door won't give. It's barred from inside.)", "Pilgrim: (Through the door, high and shaking.) Somebody tried this door an hour since, and called me by my name. I've a knife in my hand, and I'll not lift the bar for anyone till it's light.")

[node name="Charnel" type="Node" parent="Director" node_paths=PackedStringArray("body")]
script = ExtResource("find_gd")
phase = 4
duty = "The round: the charnel house"
body = NodePath("../../Bodies/Edwin")
lines = PackedStringArray("(In the charnel house, laid out straight among the piled bones with his hands folded on his breast: Edwin.)", "(His habit is torn open. Across his chest run rows of fine, close cuts, as if the teeth of a comb had been dragged through him.)")
drugged_lines = PackedStringArray("Edwin: (Sitting up among the bones, his folded hands falling open.) You're late, Alric. I waited for you after Matins.", "Edwin: I saw its face. You've eaten bread from its hand. So have I.")

[node name="Hunters" type="Node" parent="Director" node_paths=PackedStringArray("ahead", "behind")]
script = ExtResource("two_gd")
phase = 4
duty = "Run. Hide."
ahead = NodePath("../../Marks/HunterAhead")
behind = NodePath("../../Marks/HunterBehind")
two_lines = PackedStringArray("(The horned shape stands in the fog ahead of you. Behind you, close, something breathes. You turn: it's there too.)")
unmask_lines = PackedStringArray("(The hunter stumbles in the fog, and the mask comes away in his hand. The face under it is red and sweating, and you know it.)", "(Brother Osric. He swears under his breath, drags the mask back on, and comes for you.)")

[node name="Simon" type="Node" parent="Director" node_paths=PackedStringArray("people", "marks")]
script = ExtResource("scene_gd")
phase = 4
duty = "The cloister: someone on his knees on the flags"
people = [NodePath("../../Brothers/Simon")]
marks = [NodePath("../../Marks/SimonScrubbing")]
lines = PackedStringArray("(Brother Simon is on his knees on the cloister flags, scrubbing at a dark stain. The water in his bucket is red.)", "(He sees your lantern and pushes the rag behind his back.)", "Simon: It's wine. Only wine, somebody spilled it. Please, porter. You didn't see me here.")
flag = &"simon_scrubbing"
note = &"simon_blood"

