[node name="Night4" instance=ExtResource("base")]
editor_description = "Night 4, Edwin (design doc, Night 4): no supper (the fast), Edwin's whisper and Thomas on Simon at dusk, Mab let in and a pilgrim at the gate, Edwin missing at Matins, a brother killed in the fog with the prior kneeling by him, the guest killed unless warned, Edwin in the charnel house, two hunters and Osric unmasked, Simon scrubbing blood, and at dawn someone in his cell. It inherits night_base.tscn."

