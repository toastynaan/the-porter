duty = "At Lauds: give the gate to Cole, and sleep"
gate = NodePath("../../AbbeyGate")
cole = NodePath("../../People/Cole")
cole_off = NodePath("../../Marks/ColeOff")
cole_gate = NodePath("../../Marks/ColeGate")
