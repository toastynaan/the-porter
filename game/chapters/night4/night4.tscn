[node name="Wake" type="Node" parent="Director" node_paths=PackedStringArray("wake_at", "tower", "gate")]
script = ExtResource("wake_gd")
phase = 6
bell = &"start"
wake_at = NodePath("../../Marks/WakeCell")
tower = NodePath("../../BellTower")
gate = NodePath("../../AbbeyGate")
lines = PackedStringArray("(You wake to a white blank at the crack of the shutter. Fog, thick and wet, pressed up against the wall.)", "(No supper bell tonight. The abbot's order, given at Lauds: the house fasts against the demon, and the refectory is locked.)", "(Across the court the gate stands open, and Cole stands in it, half gone into the fog.)")
supper_bell = false

[node name="Edwin" type="Node" parent="Director" node_paths=PackedStringArray("people", "marks")]
script = ExtResource("scene_gd")
phase = 6
duty = "Dusk: Edwin is waiting for you"
people = [NodePath("../../Brothers/Edwin")]
marks = [NodePath("../../Marks/EdwinDusk")]
lines = PackedStringArray("(Edwin comes up out of the fog at your elbow and takes your sleeve. He's white to the lips, and for once he isn't talking.)", "Edwin: I've seen its face, Alric. The demon's. As close as I am to you.", "Edwin: Not here. After Matins, at your gate. I'll tell you all of it then, I swear.")
flag = &"edwin_whisper"

[node name="Thomas" type="Node" parent="Director" node_paths=PackedStringArray("people", "marks")]
script = ExtResource("scene_gd")
phase = 6
duty = "Dusk: Thomas, by the gate"
people = [NodePath("../../Brothers/Thomas")]
marks = [NodePath("../../Marks/ThomasDusk")]
lines = PackedStringArray("Thomas: (Low, falling into step beside you in the fog.) I've seen Brother Simon out at night, Alric. Long after Compline, when he should be abed.", "Thomas: Down on his knees in the cloister, at an hour nobody prays. Watch him. And say nothing.")
flag = &"thomas_simon"

