[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n4_choirb"
text = "# DRAFT
# Brother Aldo in the nave at dusk (night 4, fog), setting out the psalters. Background; young.
# Bede's stall stays empty by the abbot's order. If Thomas has named Simon (n4_thomas_simon), Aldo bears it out:
# Simon sleeps in the next bed and goes down the night stair after Compline (because Thomas sends him).
== start
(Brother Aldo in the nave, setting out the psalters. The fog has come in at the west door and hides the altar.)
Aldo {wary}: Porter. Mind where you walk. I've lost two psalters in it already.
-> topics

== again
Aldo {weary}: Still here? So am I. There's no supper to go to.
-> topics

== topics
* [if not n4_choirb_bede] Why is Brother Bede's stall left empty? -> bede
* [if n4_thomas_simon] [if not n4_choirb_simon] What do you know of Brother Simon? -> simon

== bede [set n4_choirb_bede]
Aldo {grave}: Father Abbot says nobody's to sit in it. His psalter's still there. Nobody will touch it.
Aldo {sad}: Nobody will sit next to it either. So I do.
-> topics

== simon [set n4_choirb_simon]
Aldo {calm}: Simon? His bed's next to mine. He's up after Compline, these last nights. I hear him go down the night stair.
Aldo {weary}: He says he can't sleep. Who can?
-> topics

== leave
Aldo {afraid}: Ring it loud tonight, porter. We'll want to hear it through this.
"
