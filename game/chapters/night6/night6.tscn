[node name="SaintKills" type="Node3D" parent="." node_paths=PackedStringArray("saint", "deaths")]
script = ExtResource("kills_gd")
saint = NodePath("../Saint")
deaths = [NodePath("../SaintDeaths/Dunstan"), NodePath("../SaintDeaths/Cole"), NodePath("../SaintDeaths/Osric")]
lines = Array[PackedStringArray]([PackedStringArray("(Dunstan comes along the walk in his horns, hunting you, and walks into its reach. It lifts him off the flags by the head. He kicks, without a sound, and then he stops.)", "(It lets him fall. His mask rolls away across the snow, and the blood runs out dark under him. Then it turns its head toward you.)"), PackedStringArray("(Cole stands with his back to the gate and his arms spread across the bar, keeping it shut against you. He doesn't speak. He never has.)", "(Out of the dark beside the porch a long hand comes down over his shoulder. One finger draws across his throat, and the blood flies through your light.)"), PackedStringArray("(In the choir the candles are going out one by one along the stalls, closing in on the horned shape at the altar step. It turns and turns, its light held up.)", "(The last candle goes, and then its light. In the dark it makes one sound. Then nothing.)")])

[node name="Demon" type="Node3D" parent="." node_paths=PackedStringArray("from")]
script = ExtResource("demon_gd")
visitor = ExtResource("prior")
visitor_scene = ExtResource("visitor_npc")
from = NodePath("../Marks/DemonFrom")
demon_lines = PackedStringArray("(A light comes at you round the corner, and behind it the demon: huge, crowned with horns, its eyes burning. There's no way past it.)", "(Its long fingers reach for you. Its mouth works round your name, and what comes out is no word at all.)")
struck_lines = PackedStringArray("(You strike at it with all you have, and again, and again, and it goes down, and you go on striking until it's still.)", "(Its light rolls away across the flags and lies there, burning.)")
ran_lines = PackedStringArray("(You run. Behind you the light stops, and a voice calls after you, and you don't stop to hear whose.)")

[node name="Ending" type="Node" parent="." node_paths=PackedStringArray("director", "demon", "knock", "race_exit")]
script = ExtResource("ending_gd")
director = NodePath("../Director")
demon = NodePath("../Demon")
knock = NodePath("../Director/Knock")
race_exit = NodePath("../Marks/RaceExit")
lines = {&"demon": PackedStringArray("(Grey light, and your head clear at last. The thing at your feet is a man in a prior's habit, his lantern on its side beside him, burned out.)", "(It's Hugh. His hand is still open toward you, and there's nothing in it.)"), &"rising": PackedStringArray("(The gate stands open. It goes out under the porch, stooping to clear the arch, and it doesn't hurry.)", "(Its tracks go away up the lane in the new snow, long and narrow and far apart, toward the lights of the city.)"), &"fire": PackedStringArray("(You hold the lantern to it and wait. A brown scorch, a thread of smoke, then the flame takes, and runs upward faster than you can step back.)"), &"gate": PackedStringArray("(You lift the bar and swing the gate back. Roger looks at what you hold up to him, then waves his men in past you, torches high, into the snow of the court.)", "Roger {amused}: (Looking past you at the church, the granary, the long roofs white with snow.) That'll do, porter. That'll do very well."), &"witness": PackedStringArray("(Down the steps into the race. The water takes you to the waist, and the cold of it stops your breath.)", "(Where the race runs out under the wall the arch comes down almost to the water. You duck under, her hand knotted in the back of your habit, and come up in the snow at the bottom of the lane.)"), &"broken_rite": PackedStringArray("(Grey light comes up over the snow. Somewhere in the city a bell rings for Lauds, then another, then all of them.)", "(Nothing comes. The abbey's bell never rings, and the snow goes on falling on the tracks in the court until they're gone.)")}

[node name="Director" type="Node" parent="."]
script = ExtResource("director_gd")
night = 6
start_dose = 35.0
start_flags = Array[StringName]([&"bread_warned", &"keys_copied", &"died_merchant", &"died_edwin", &"thomas_custody"])
start_count = 7

[node name="Wake" type="Node" parent="Director" node_paths=PackedStringArray("wake_at", "tower", "gate", "alt_at")]
script = ExtResource("wake_gd")
phase = 6
bell = &"start"
wake_at = NodePath("../../Abbey/Navigation/GraveyardInfirmary/Markers/WakePoint")
tower = NodePath("../../BellTower")
gate = NodePath("../../AbbeyGate")
lines = PackedStringArray("(You wake in a bed in the infirmary. Snow is falling past the window, slow and thick, and the light behind it is nearly gone.)", "(No supper bell. No gate to take, no bell to ring, no round. You're in Thomas's care tonight, and nothing else is asked of you.)")
supper_bell = false
alt_at = NodePath("../../Marks/WakeCell")
alt_if = &"prior_believes"
alt_lines = PackedStringArray("(You wake on your own cot. Snow is falling past the shutter, and the court beyond it is white and silent.)", "(No bell. The prior let you go at first light, and nobody has come for you since. There's no gate for you to keep tonight.)")

[node name="Anselm" type="Node" parent="Director" node_paths=PackedStringArray("body")]
script = ExtResource("find_gd")
phase = 6
duty = "Anselm, in his bed"
body = NodePath("../../Bodies/Anselm")
lines = PackedStringArray("(Anselm lies in his bed by the wall, on his back, his blind eyes open on the rafters.)", "(His mouth is packed with leaves, grey-green and sticky, crammed in past the teeth. Henbane. The jar on the shelf above him stands open.)")

[node name="Wine" type="Node" parent="Director" node_paths=PackedStringArray("thomas", "at")]
script = ExtResource("wine_gd")
phase = 6
duty = "Thomas, with a cup"
thomas = NodePath("../../Brothers/Thomas")
at = NodePath("../../Marks/ThomasWine")
offer_lines = PackedStringArray("Thomas {warm}: (Holding out a steaming cup.) Hot wine, Alric, with spice in it. For the cold. You've had nothing all day.", "Thomas {warm, still}: Go on, all of it, while it's hot. (He sits down where he can watch you drink.)")
drunk_lines = PackedStringArray("(It's sweet and scalding. Under the spice it tastes of the bread, and of the incense, and of something under both that you've never tasted.)", "(Thomas takes the empty cup out of your hands, and smiles.)")
refused_lines = PackedStringArray("(You push the cup away. For a moment the face over it isn't one you know: still, and cold, and measuring you.)", "Thomas {warm}: (Then he smiles, the same as always.) As you like, Alric. I'll leave it here, in case you change your mind.")

[node name="Hunt" type="Node" parent="Director" node_paths=PackedStringArray("hunt")]
script = ExtResource("hunt_gd")
phase = 2
bell = &"hunt"
quiet = true
duty = "There's no gate to keep tonight. Find the proof. Stop the rite."
hunt = NodePath("../../Hunt")
lines = PackedStringArray("(They're all out tonight. Horned shapes in the snow of the garth, on the walks, at the church door, and none of them troubling to hide.)", "(There's no gate to keep tonight, and nowhere that's yours. Somewhere across the court a door slams, and a bar drops into its brackets.)")

[node name="Knock" type="Node" parent="Director" node_paths=PackedStringArray("grate", "porch", "inside", "gate")]
script = ExtResource("knock_gd")
phase = 2
hour = 20.0
grate = NodePath("../../Duties/Grate")
roger = ExtResource("v_roger")
joan = ExtResource("v_joan")
mab = ExtResource("v_mab")
visitor_scene = ExtResource("visitor_npc")
porch = NodePath("../../Marks/Porch")
inside = NodePath("../../Marks/Inside")
gate = NodePath("../../AbbeyGate")
roger_lines = PackedStringArray("(A staff hammers on the gate. Through the grille: Roger the bailiff in the falling snow, and men of the ward behind him with torches.)")
joan_lines = PackedStringArray("(A quick, quiet knock. Snow on her hood, her hands on the bars: Joan, alive, the woman you turned away.)")
mab_lines = PackedStringArray("(A dry clack at the grille: a leper's clapper. Mab, white with snow, her face wrapped to the eyes.)")

[node name="Eyes" type="Node" parent="Director"]
script = ExtResource("lines_gd")
phase = 2
at_hour = 21.0
lines = PackedStringArray("Hugh {grave}: (He holds his lantern up to your face.) Your eyes are black to the rims. You're full of it, brother, whatever they've fed you.")
min_dose = 75.0

[node name="Rite" type="Node" parent="Director" node_paths=PackedStringArray("victim", "thomas", "thomas_at", "book", "saint")]
script = ExtResource("rite_gd")
phase = 3
bell = &"rite"
quiet = true
due = 24.0
duty = "The crypt: stop the rite before Matins"
begins = 23.0
victim = NodePath("../../Victim")
thomas = NodePath("../../Brothers/Thomas")
thomas_at = NodePath("../../Marks/ThomasRite")
book = NodePath("../../Proof/Book")
saint = NodePath("../../Saint")
rite_lines = PackedStringArray("(The crypt is full of light. The candles burn in their ring on the floor, and inside the ring a man lies bound hand and foot, his face turned toward the stair.)", "(At the altar stands a man in a black habit, his hood back, reading aloud from the book in a voice you know. Thomas.)")
freed_lines = PackedStringArray("(The last cord gives. He's up and stumbling for the stair without a word, and his bare feet slap away into the dark.)")
book_lines = PackedStringArray("(You take the book off the altar. It's heavier than it looks, and warm, as if a hand had only now left it.)", "Thomas {angry}: (A shout, in a voice you've never heard from him.) Alric! Put it back! You don't know what you're holding!")
done_lines = PackedStringArray("(It's Matins, and no bell rings for it. Inside the ring the bound man cries out once, and Thomas closes the book.)", "(Every candle in the ring flares up at once, tall and still, and all the flames lean one way: toward the dark under the altar.)")
silence_lines = PackedStringArray("(The wind drops. The rooks in the tower go quiet. Your lantern sinks low, though nothing touches it.)", "(Something stands ahead of you that wasn't there. Too tall, too thin, bent forward as if the roof were too low for it, and no horns. You've seen it before, through the squint.)", "(Then it moves. Slowly, in plain sight, toward you, and your lantern light falls into it and shows nothing.)")

[node name="ToDawn" type="Node" parent="Director"]
script = ExtResource("hold_gd")
phase = 7
duty = "Hold out until Lauds, or get out"
