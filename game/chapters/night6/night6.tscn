[node name="Night6" instance=ExtResource("base")]
editor_description = "Night 6, the hunt (design doc, Night 6): no routine; Anselm dead in his bed; Thomas's wine; the whole cult in costume; a knock at the gate (Roger, Joan or Mab); the proof in the crypt passage; the Hungry Saint as Matins nears; the rite in the crypt, stopped or not; fire; and the seven endings. It inherits night_base.tscn."

