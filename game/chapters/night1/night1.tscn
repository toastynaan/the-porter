[node name="SmallHours" type="Node" parent="Director" node_paths=PackedStringArray("bench", "tower", "gate_lamp")]
script = ExtResource("small_gd")
phase = 7
due = 30.0
can_doze = true
duty = "Watch the gate until Lauds"
bench = NodePath("../../GateBench")
tower = NodePath("../../BellTower")
gate_lamp = NodePath("../../Lamps/GateLamp")
lines = PackedStringArray("(Back to the gate. Keep watch from the bench until Lauds. You can doze, if you dare.)")
lauds_lines = PackedStringArray("(The Lauds bell. Grey light comes up over the court.)")

[node name="Pond" type="Node" parent="Director" node_paths=PackedStringArray("body", "witness", "witness_at")]
script = ExtResource("find_gd")
phase = 5
duty = "Lauds: the shouting at the fishpond"
body = NodePath("../../Bodies/Pond")
witness = NodePath("../../Brothers/Thomas")
witness_at = NodePath("../../Marks/PondThomas")
shout_lines = PackedStringArray("(Shouting, from the direction of the fishpond.)")
found_lines = PackedStringArray("(Your lantern passes over the water, and a face looks up at you from just under the surface.)", "(It turns slowly in the black water, and rolls over.)", "Thomas {sad, still}: The merchant. He drowned drunk, poor soul, wandering about in the dark. It happens.", "(Dunstan stands at the water's edge with a boathook, and says nothing.)")
locked_lines = PackedStringArray("Merchant {angry}: Locked in! Like a sheep in a fold, porter, and me a guest of this house!", "Merchant {angry, jaw}: I'll tell every inn from here to Coventry how your abbey treats its pilgrims.")
lived_lines = PackedStringArray("Merchant {cold}: Cold as a tomb, your guesthouse. I've slept warmer in a ditch. Good day to you, porter.")

[node name="Dawn" type="Node" parent="Director" node_paths=PackedStringArray("gate", "cole", "cole_off", "cole_gate", "hand_over", "cell", "keys_on_hook", "sleep")]
script = ExtResource("dawn_gd")
phase = 5
due = 30.0
watch_late = true
duty = "At Lauds: give the gate to Cole, and sleep"
gate = NodePath("../../AbbeyGate")
cole = NodePath("../../People/Cole")
cole_off = NodePath("../../Marks/ColeOff")
cole_gate = NodePath("../../Marks/ColeGate")
hand_over = NodePath("../../Duties/HandOver")
cell = NodePath("../../Marks/DawnCell")
cell_radius = 2.5
keys_on_hook = NodePath("../../Marks/KeysOnHook")
sleep = NodePath("../../Duties/Sleep")
cole_lines = PackedStringArray("(Cole comes across the court for the gate. He holds out his hand for it, and says nothing.)", "(He lifts the bar and swings the gate open on the grey lane.)")
sleep_line = "(You lie down on your cot, and the day closes over you.)"
