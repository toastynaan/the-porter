child_knock = false
visitor_scene = ExtResource("visitor_npc")
prior_visitor = ExtResource("prior")
lane_start = NodePath("../../Marks/LaneStart")
lane_leave = NodePath("../../Marks/LaneLeave")
porch = NodePath("../../Marks/Porch")
inside = NodePath("../../Marks/Inside")
prior_from = NodePath("../../Marks/PriorFrom")
grate = NodePath("../../Duties/Grate")
bar_duty = NodePath("../../Duties/BarGate")
open_gate = NodePath("../../Duties/OpenGate")
shut_gate = NodePath("../../Duties/ShutGate")
ledger = NodePath("../../Duties/Ledger")
beds = NodePath("../../Duties/GuestBeds")
gate = NodePath("../../AbbeyGate")
prior_lines = PackedStringArray("Hugh {cold}: Stand aside, porter. I'll see him to a bed myself.", "Hugh {cold, jaw}: (To the visitor.) This way. Keep close, and touch nothing.")

