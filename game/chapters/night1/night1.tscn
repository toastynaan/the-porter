walk_end = NodePath("../../Stalk/WalkEnd")
doorways = NodePath("../../Stalk/Doorways")
appearances = 1
glimpse_lines = PackedStringArray("(A tall shape with horns at the far end of the walk, perfectly still. You look again, and there's nothing.)")

