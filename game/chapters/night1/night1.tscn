night = 1
start_flags = Array[StringName]([&"d1_tour_done"])

[node name="Wake" type="Node" parent="Director" node_paths=PackedStringArray("wake_at", "tower", "gate")]
script = ExtResource("wake_gd")
phase = 6
bell = &"start"
due = 17.25
wake_at = NodePath("../../Marks/WakeCell")
tower = NodePath("../../BellTower")
gate = NodePath("../../AbbeyGate")
lines = PackedStringArray("(You wake on your cot in the porter's cell. The light through the shutter is going.)", "(Across the court the gate stands open, and Cole stands in it, watching the lane.)", "(Someone has set a fresh candle in the clock on your desk while you slept.)")

[node name="Supper" type="Node" parent="Director" node_paths=PackedStringArray("seat", "seat_duty", "bread", "osric", "thomas", "watcher", "warner")]
script = ExtResource("supper_gd")
phase = 0
due = 17.25
watch_late = true
fetcher = &"cole"
duty = "Supper in the refectory, at the supper bell"
seat = NodePath("../../Marks/PorterSeat")
seat_duty = NodePath("../../Duties/SupperSeat")
bread = NodePath("../../Duties/Bread")
osric = NodePath("../../Brothers/Osric")
thomas = NodePath("../../Brothers/Thomas")
watcher = NodePath("../../Brothers/Hugh")
warner = NodePath("../../Brothers/Warner")
seated_lines = PackedStringArray("(The abbot rises at the high table, leaning on his crosier, and the brothers fall quiet.)", "Godric {warm}: Brothers, this is Brother Alric, who keeps our gate from tonight, as Anselm kept it before him.", "Godric {warm}: You're welcome among us, my son. Eat, and God keep you through the night.")
serve_lines = PackedStringArray("(Osric sets down your bread and ale, then a second heel of bread beside them, and winks.)", "Osric {glad, smile}: A new porter wants feeding. The nights are long at that gate.")
eat_lines = PackedStringArray("(Dark rye, dense and a little sour. You eat it all.)")
warn_lines = PackedStringArray("(The choir brother beside you leans in, his eyes on his own plate.)", "Bede {afraid, swallow}: Don't eat the bread, porter. Not tomorrow, not any night. Something is wrong with it.", "Bede {afraid, look down}: Don't look at me. Don't ask me here. Eat your pottage.")
palm_seen_lines = PackedStringArray("Osric {glad}: (From the hatch, smiling.) Not hungry, porter? I'll keep an eye on you. Can't have you wasting away.")

[node name="Gate" type="Node" parent="Director" node_paths=PackedStringArray("gate", "cole", "cole_off", "relieve", "shut_gate", "bar_duty", "ledger")]
script = ExtResource("gate_gd")
phase = 1
duty = "After supper: take the gate from Cole, shut and bar it, open the ledger"
gate = NodePath("../../AbbeyGate")
cole = NodePath("../../People/Cole")
cole_off = NodePath("../../Marks/ColeOff")
relieve = NodePath("../../Duties/RelieveCole")
shut_gate = NodePath("../../Duties/ShutGate")
bar_duty = NodePath("../../Duties/BarGate")
ledger = NodePath("../../Duties/Ledger")
relieve_lines = PackedStringArray("(Cole takes his hand off the gate and steps back to let you have it.)", "Cole {blank}: Yours.")

[node name="Knocks" type="Node" parent="Director" node_paths=PackedStringArray("lane_start", "lane_leave", "porch", "inside", "prior_from", "grate", "bar_duty", "open_gate", "shut_gate", "ledger", "beds", "gate")]
script = ExtResource("visits_gd")
