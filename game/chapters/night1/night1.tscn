[node name="Night1" instance=ExtResource("base")]
editor_description = "Night 1, the new porter (design doc, Night 1): the tutorial night. Supper with everyone, Bede's warning about the bread, the merchant and Walter at the gate, the first Matins and incense, the round with one glimpse, the cult coming for an unprotected guest, the knock with no one there, and at dawn the merchant in the fishpond, or alive. It inherits night_base.tscn."

