[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n1_cole"
text = "# DRAFT
# Cole, the lay brother, keeping the gate at dusk (night 1). Big and silent: a word or two at most, and a look.
== start
(Cole stands in the gate's arch with the rain running off his hood. He looks at you, then at the keys on your belt.)
-> topics

== again
(Cole looks at you and says nothing.)
-> topics

== topics
* [if not n1_cole_take] I'll take the gate after supper. -> take
* [if not n1_cole_today] Did anyone come to the gate today? -> today

== take [set n1_cole_take]
Cole: After supper.
(He nods once, and goes back to watching the lane.)
-> topics

== today [set n1_cole_today]
(He thinks about it.)
Cole: Candle girl.
-> topics

== leave
(Cole watches you go.)
"
