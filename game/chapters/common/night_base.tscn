[node name="Night" type="Node3D"]
editor_description = "The furniture every night shares: the abbey, the brothers and the lane's people at their places, the duties, lamps, marks, the candle clock, the gate and the bell, the hunter and the demon. Each night inherits it (night1.tscn ... night6.tscn) and adds its Director and beats, its conversations and its own things."

