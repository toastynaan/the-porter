[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n3_ranulf"
text = "# DRAFT
# Ranulf at dusk, in the church (night 3). The sacrist: rigid, a narrow pale face that doesn't blink; his censer chain clinks.
# He keeps the relic, the candles and the incense. (He wears the horned costume. Nothing here says so.)
== start
(Ranulf is trimming the candles along the choir, one by one. He doesn't turn until you're close.)
Ranulf {cold}: Porter. You're early. The church isn't yours until Matins.
-> topics

== again
(He goes on trimming the candles. The censer hangs from his belt on its chain.)
Ranulf {cold}: Porter. Again.
-> topics

== topics
* [if not n3_ranulf_incense] Why so much incense, Brother Ranulf? -> incense
* [if not n3_ranulf_relic] What is the relic, brother? -> relic
* [if not n3_ranulf_candles] You burn a great many candles now, brother. -> candles

== incense [set n3_ranulf_incense]
Ranulf {grave}: Father Abbot has ordered it at every office now. Twice the measure at Matins.
Ranulf {grave, glance}: The smoke drives out what shouldn't be here. Breathe it in, porter. Breathe deep. It's for your protection.
-> topics

== relic [set n3_ranulf_relic]
Ranulf {grave}: The saint's finger, in its silver case. Pilgrims walk from Kent to kiss the glass over it.
Ranulf {cold}: It's in my keeping. Not yours. Not the prior's. Mine.
-> topics

== candles [set n3_ranulf_candles]
Ranulf {grave, glance}: Wax is dear, and the house burns more of it every night. Father Abbot wants no dark corner for the thing to stand in.
(He doesn't blink.)
Ranulf {cold}: Don't take my candles to light your lantern, porter. I count them.
-> topics
"
