due = 30.0
watch_late = true
duty = "At Lauds: give the gate to Cole, and sleep"
gate = NodePath("../../AbbeyGate")
cole = NodePath("../../People/Cole")
cole_off = NodePath("../../Marks/ColeOff")
cole_gate = NodePath("../../Marks/ColeGate")
hand_over = NodePath("../../Duties/HandOver")
cell = NodePath("../../Marks/DawnCell")
cell_radius = 2.5
keys_on_hook = NodePath("../../Marks/KeysOnHook")
keys_moved = NodePath("../../Duties/KeysMoved")
sleep = NodePath("../../Duties/Sleep")
cole_lines = PackedStringArray("(Cole comes across the court for the gate. He holds out his hand for it, and says nothing.)", "(He lifts the bar and swings the gate open on the grey lane.)")
keys_lines = PackedStringArray("(They're on your cot. There's wax in the teeth: someone has taken a mould of them.)")
sleep_line = "(You lie down on your cot, and the day closes over you.)"
