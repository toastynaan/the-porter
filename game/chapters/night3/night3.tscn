appearance = {"skin": Color(0.72, 0.6, 0.5, 1), "shirt": Color(0.36, 0.3, 0.22, 1), "pants": Color(0.25, 0.22, 0.18, 1), "height": 1.0, "width": 1.0}
killer_node = NodePath("../Hunter")
editor_description = "The bound pilgrim killed in the crypt by the figure with his back to the stair (night 3's witnessed death: gory). It feeds the rite."

[node name="BookPage" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 25.4, -4, -32.8)
script = ExtResource("readable_gd")
id = &"book_page"
title = "A page torn from a book"
text = "...and he who is hungry shall be fed in six nights, ten souls and no fewer, and for every soul a candle, that he may count them. The last shall be given him at Matins of the sixth night, in the place beneath the altar. Then shall he rise who was hungry, and go out at the gate, and walk in the city, and be fed.

[i](Under the words, ten candles drawn in a ring around a tall figure with no face.)[/i]"
item = &"book_page"
clue = &"crypt_book"
editor_description = "A page of the cult's book by the crypt altar (night 3): what the candles are for."

[node name="Director" type="Node" parent="."]
script = ExtResource("director_gd")
night = 3
start_dose = 30.0
start_flags = Array[StringName]([&"bread_warned"])

[node name="Wake" type="Node" parent="Director" node_paths=PackedStringArray("wake_at", "tower", "gate")]
script = ExtResource("wake_gd")
phase = 6
bell = &"start"
due = 17.25
wake_at = NodePath("../../Marks/WakeCell")
tower = NodePath("../../BellTower")
gate = NodePath("../../AbbeyGate")
lines = PackedStringArray("(You wake cold. Through the crack of the shutter the sky is clear and hard, the first stars out.)", "(The gate stands open, and Cole stands in it, his breath smoking.)", "(The court smells of incense already. The abbot's order: smoke at every office now.)")

[node name="Supper" type="Node" parent="Director" node_paths=PackedStringArray("aside_by", "seat", "seat_duty", "bread", "osric", "thomas", "ranulf", "watcher")]
script = ExtResource("supper_gd")
phase = 0
due = 17.25
watch_late = true
fetcher = &"cole"
duty = "Supper in the refectory, at the supper bell"
seat = NodePath("../../Marks/PorterSeat")
seat_duty = NodePath("../../Duties/SupperSeat")
bread = NodePath("../../Duties/Bread")
osric = NodePath("../../Brothers/Osric")
thomas = NodePath("../../Brothers/Thomas")
ranulf = NodePath("../../Brothers/Ranulf")
watcher = NodePath("../../Brothers/Hugh")
aside_by = NodePath("../../Brothers/Thomas")
aside_lines = PackedStringArray("Thomas: (Quietly, not looking at you.) The prior has been asking about you. Where you go. Who you talk to.", "Thomas: I told him you keep your hours. Keep them.")
serve_lines = PackedStringArray("(Osric sets down your bread and ale, and the heel beside them.)", "Osric: Eat up, porter. You're getting thin at that gate.")
eat_lines = PackedStringArray("(The bread is bitter tonight. The taste stays at the back of your tongue.)")
palm_seen_lines = PackedStringArray("Osric: (From the hatch, smiling.) Not hungry, porter? I'll keep an eye on you. Can't have you wasting away.")
remedy_lines = PackedStringArray("Ranulf: You keep pressing your eyes, porter. The new ones all get headaches. A few drops of this in your ale and you'll sleep.", "Thomas: (Quietly, so only you hear.) Not that, Alric. Not from him. Bring your headaches to me.")

[node name="Gate" type="Node" parent="Director" node_paths=PackedStringArray("gate", "cole", "cole_off", "relieve", "shut_gate", "bar_duty", "ledger")]
script = ExtResource("gate_gd")
phase = 1
duty = "After supper: take the gate from Cole, shut and bar it, open the ledger"
gate = NodePath("../../AbbeyGate")
cole = NodePath("../../People/Cole")
cole_off = NodePath("../../Marks/ColeOff")
relieve = NodePath("../../Duties/RelieveCole")
shut_gate = NodePath("../../Duties/ShutGate")
bar_duty = NodePath("../../Duties/BarGate")
ledger = NodePath("../../Duties/Ledger")
relieve_lines = PackedStringArray("(Cole takes his hand off the gate and steps back to let you have it.)", "Cole: Yours.")

[node name="Knocks" type="Node" parent="Director" node_paths=PackedStringArray("lane_start", "lane_leave", "porch", "inside", "prior_from", "grate", "bar_duty", "open_gate", "shut_gate", "ledger", "beds", "gate")]
