[node name="Crypt" type="Node" parent="Director" node_paths=PackedStringArray("death", "light", "hunter", "crypt")]
script = ExtResource("crypt_gd")
phase = 4
bell = &"crypt"
quiet = true
light = NodePath("../../CryptLight")
hunter = NodePath("../../Hunter")
crypt = NodePath("../../Marks/CryptFoot")
death = NodePath("../../CryptPilgrim")
light_lines = PackedStringArray("(A light, down in the crypt. Someone is down there.)")
death_lines = PackedStringArray("(At the foot of the stair, a figure in black by the light, its back to you, bent over a man bound hand and foot.)", "(The arm rises and falls, and rises. The bound man's heels drum on the flags and stop. Blood spreads into the light.)", "(The figure straightens, and turns, and looks straight at you.)")

[node name="Chase" type="Node" parent="Director" node_paths=PackedStringArray("hunter", "stalker", "oven", "blockers", "thomas", "rescue_porter", "rescue_thomas")]
script = ExtResource("chase_gd")
phase = 4
hunter = NodePath("../../Hunter")
stalker = NodePath("../../Stalker")
oven = NodePath("../../Abbey/Navigation/SouthRange/HidingSpots/Oven")
blockers = NodePath("../../Stalk/Blockers")
thomas = NodePath("../../Brothers/Thomas")
rescue_porter = NodePath("../../Marks/RescuePorter")
rescue_thomas = NodePath("../../Marks/RescueThomas")
bones_lines = PackedStringArray("(Your hand closes on something in the ash. Smooth, curved, with teeth in it. A jaw.)")
rescue_lines = PackedStringArray("(A hand takes your collar and drags you sideways through a door, into the smell of herbs.)", "Thomas: Down. Behind the bed. Not a sound.", "Thomas: (When the steps have gone.) It's gone. Breathe, Alric. I heard you running. Whatever it was, it's gone.")
caught_lines = PackedStringArray("(You wake in the infirmary. Thomas is bending over you with a cup.)", "Thomas: Lie still. I found you in the yard by the bakehouse. Drink this.")

[node name="SmallHours" type="Node" parent="Director" node_paths=PackedStringArray("bench", "tower", "gate_lamp")]
