inside = NodePath("../../Marks/Inside")
prior_from = NodePath("../../Marks/PriorFrom")
grate = NodePath("../../Duties/Grate")
bar_duty = NodePath("../../Duties/BarGate")
open_gate = NodePath("../../Duties/OpenGate")
shut_gate = NodePath("../../Duties/ShutGate")
ledger = NodePath("../../Duties/Ledger")
beds = NodePath("../../Duties/GuestBeds")
gate = NodePath("../../AbbeyGate")
prior_lines = PackedStringArray("Hugh: Stand aside, porter. I'll see him to a bed myself.", "Hugh: (To the visitor.) This way. Keep close, and touch nothing.")

