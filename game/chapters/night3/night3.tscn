[node name="CryptPilgrim" type="Node3D" parent="." node_paths=PackedStringArray("killer_node")]
transform = Transform3D(-0.9245, 0, -0.3811, 0, 1, 0, 0.3811, 0, -0.9245, 26.27, -4, -29.55)
script = ExtResource("death_gd")
id = &"crypt_pilgrim"
style = 1
