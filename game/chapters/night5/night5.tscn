duty = "Anselm, beside you"
people = [NodePath("../../Brothers/Anselm")]
marks = [NodePath("../../Marks/AnselmChoir")]
lines = PackedStringArray("(A thin hand finds your sleeve in the smoke and holds on. Anselm, his blind eyes wide.)", "Anselm {afraid, swallow}: The key to the crypt passage. It's in the granary, under the rye. Go now, while they're all looking at him.")
flag = &"anselm_key"

[node name="Granary" type="Node" parent="Director" node_paths=PackedStringArray("grain", "body", "passage", "locks", "hunter_at", "chute", "sergeant_death")]
script = ExtResource("granary_gd")
phase = 4
bell = &"granary"
quiet = true
duty = "The granary: the grain"
grain = NodePath("../../Duties/Grain")
body = NodePath("../../Bodies/Body5")
passage = NodePath("../../Abbey/Navigation/Cellar/Doors/HiddenStairDoor")
locks = [NodePath("../../Abbey/Navigation/Cellar/Doors/GranarySDoor_01"), NodePath("../../Abbey/Navigation/Cellar/Doors/WestW0Door_03"), NodePath("../../Abbey/Navigation/Cellar/Doors/WestE0Door_01"), NodePath("../../Abbey/Navigation/Cellar/Doors/WestE0Door_03"), NodePath("../../Abbey/Navigation/Cellar/Doors/WestE0Door_05"), NodePath("../../Abbey/Navigation/Cellar/Doors/StoresNDoor_00"), NodePath("../../Abbey/Navigation/Church/Doors/NaveS0Door_02"), NodePath("../../Abbey/Navigation/Church/Doors/NaveS0Door_07"), NodePath("../../Abbey/Navigation/Church/Doors/NaveS0Door_11"), NodePath("../../Abbey/Navigation/Church/Doors/NaveW0Door_01"), NodePath("../../Abbey/Navigation/Church/Doors/TowerW0Door_01"), NodePath("../../Abbey/Navigation/Dormitory/Doors/EastW0Door_00"), NodePath("../../Abbey/Navigation/Dormitory/Doors/EastW0Door_02"), NodePath("../../Abbey/Navigation/Dormitory/Doors/EastW0Door_03"), NodePath("../../Abbey/Navigation/Dormitory/Doors/EastW0Door_05"), NodePath("../../Abbey/Navigation/Dormitory/Doors/EastE0Door_00"), NodePath("../../Abbey/Navigation/Dormitory/Doors/EastE0Door_07"), NodePath("../../Abbey/Navigation/Dormitory/Doors/EastS0Door_01"), NodePath("../../Abbey/Navigation/Dormitory/Doors/WarmingSDoor_01"), NodePath("../../Abbey/Navigation/Dormitory/Doors/LatrineE0Door_00")]
hunter_at = [NodePath("../../Marks/GranaryHunter"), NodePath("../../Marks/ChoirHunter")]
chute = NodePath("../../Abbey/Navigation/Dormitory/Squeezes/LatrineChute")
sergeant_death = NodePath("../../SergeantDeath")
joan_lines = PackedStringArray("(You push your arm into the rye to the shoulder, feeling for iron. Under the grain, a hand closes on yours.)", "(The rye heaves and slides, and Joan's face comes up out of it, her mouth full of grain, her eyes on yours. She's holding on.)", "(Then her grip goes slack, and she slides back under, and is still.)")
pilgrim_lines = PackedStringArray("(You push your arm into the rye to the shoulder, feeling for iron. Under the grain, a hand closes on yours.)", "(You drag it up into the light: grey, shrunken, the nails black. A pilgrim, long dead, and his fingers still locked round yours.)")
ergot_lines = PackedStringArray("(Black spurs among the rye, hard and curved, more of them than grain in places. Osric said the rye came in damp.)")
key_lines = PackedStringArray("(At the bottom of the bin your fingers close on iron: a long key on a loop of cord.)")
locked_lines = PackedStringArray("(Behind you the granary doors slam, and a bar drops across them on the outside.)", "(Steps in the passage. Unhurried. More than one man.)")
sergeant_lines = PackedStringArray("(From out in the lane, over the wall: a man's shout, cut off, and a lantern smashing on the stones.)")
out_lines = PackedStringArray("(Down the latrine chute feet first, into the cold black water of the mill race. No man in a mask can follow you through there.)")

[node name="SmallHours" type="Node" parent="Director" node_paths=PackedStringArray("bench", "tower", "gate_lamp")]
script = ExtResource("small_gd")
phase = 7
due = 30.0
can_doze = true
duty = "Watch the gate until Lauds"
bench = NodePath("../../GateBench")
tower = NodePath("../../BellTower")
gate_lamp = NodePath("../../Lamps/GateLamp")
lines = PackedStringArray("(Back to the gate. Keep watch from the bench until Lauds. You can doze, if you dare.)")
lauds_lines = PackedStringArray("(The Lauds bell. Grey light comes up over the court.)")

[node name="Arrest" type="Node" parent="Director" node_paths=PackedStringArray("people", "marks", "thomas", "thomas_at")]
script = ExtResource("arrest_gd")
phase = 5
duty = "Lauds: the prior, at the gate"
people = [NodePath("../../Brothers/Hugh"), NodePath("../../Brothers/ChoirB"), NodePath("../../Brothers/ChoirC")]
marks = [NodePath("../../Marks/HughArrest"), NodePath("../../Marks/ArrestA"), NodePath("../../Marks/ArrestB")]
thomas = NodePath("../../Brothers/Thomas")
thomas_at = NodePath("../../Marks/ThomasArrest")
arrest_lines = PackedStringArray("(At first light the prior is waiting at the gate, two brothers at his back. They take your arms.)", "Hugh {cold, jaw}: Brother Alric, I'm holding you for the killings in this house. Every one of them since you came to that gate.", "Hugh {cold}: If you have anything to show me, show it now, porter. I won't ask twice.")
believed_lines = PackedStringArray("Hugh {grave}: (He looks a long time at what you've shown him, then at his wax.) Let go of him. Go to your beds, both of you.", "Hugh {grave, jaw}: I've been watching the wrong man, porter. Tonight I'll stand with you, whatever comes.")
custody_lines = PackedStringArray("Hugh {cold}: That's all? It isn't enough. You'll be held until I'm sure of you.", "Thomas {warm}: (Crossing the court, his arm bound.) Prior, look at his eyes. He's sick. He's been seeing things for days. Give him to me. I'll keep him in the infirmary and answer for him myself.", "Hugh {cold, jaw}: Into your care, then, brother. Yours. If he walks out of it, it's on your head.")

[node name="Sergeant" type="Node" parent="Director"]
script = ExtResource("lines_gd")
phase = 5
lines = PackedStringArray("(Out in the lane, by the gate, the sergeant's lantern lies smashed, and the stones around it are black with blood.)")
only_if = &"died_sergeant"

