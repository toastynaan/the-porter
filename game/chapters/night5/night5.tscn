[node name="Night5" instance=ExtResource("base")]
editor_description = "Night 5, the granary (design doc, Night 5): the dilemma in the chapter house at dusk (Thomas or Simon), Osric at supper, Joan back (if turned away) and Roger's sergeant at the gate, the abbot falling at Matins and Anselm's word about the key, the grain and body 5, the hidden stair, the lock-in and the latrine chute, the sergeant in the lane unless let in, and at dawn the prior's arrest. It inherits night_base.tscn."

