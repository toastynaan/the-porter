count_lines = PackedStringArray("(The incense rolls thick off the censers. In his stall the abbot sways, gropes for his crosier, and goes down on the flags.)", "(Brothers crowd round him in the smoke. Someone is shouting for Thomas. Nobody is singing.)")

[node name="Anselm" type="Node" parent="Director" node_paths=PackedStringArray("people", "marks")]
script = ExtResource("scene_gd")
