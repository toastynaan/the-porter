[node name="Dilemma" type="Node" parent="Director" node_paths=PackedStringArray("thomas", "thomas_down", "thomas_up", "simon", "masked", "death", "reach_thomas", "reach_simon")]
script = ExtResource("dilemma_gd")
phase = 6
bell = &"dilemma"
quiet = true
duty = "The chapter house"
thomas = NodePath("../../Brothers/Thomas")
thomas_down = NodePath("../../Marks/ThomasDown")
thomas_up = NodePath("../../Marks/ThomasUp")
simon = NodePath("../../Brothers/Simon")
masked = NodePath("../../Masked")
death = NodePath("../../SimonDeath")
reach_thomas = NodePath("../../Duties/ReachThomas")
reach_simon = NodePath("../../Duties/ReachSimon")
lines = PackedStringArray("(Thomas lies on the chapter house floor, blood on his face, trying to rise. Across the room a masked man has Brother Simon down against the stone bench, a knife at his throat.)", "(There's time to reach one of them. Only one.)")
thomas_lines = PackedStringArray("(You go down on your knees by Thomas. Behind you, one quick stroke, and blood flies across the last of the light.)", "(Simon folds against the bench. The masked man straightens over him, turns, and looks at you for a long moment.)", "(Then he steps back through the slype door, and is gone.)")
thomas_after = PackedStringArray("Thomas {pained, still}: (Holding his side, his breath short.) It came at us out of nowhere, Alric. I tried to pull it off him. God forgive me, I couldn't.", "Thomas {warm}: Help me up. And don't go after it. Promise me.")
simon_lines = PackedStringArray("(You throw yourself at the masked man and drag him off Simon. He tears free, and is out through the slype door and gone.)", "(Simon lies against the bench, gasping, his hands at his throat. They come away with only a little blood.)", "(Behind you Thomas gets to his feet, slowly, blood down his face and one arm held tight against his side.)")
simon_tells = PackedStringArray("Simon {afraid}: (Low, his eyes on Thomas.) The blood on the flags last night. Brother Thomas sent me to scrub it. He said it was for the good of the house, and to tell no one.", "Simon {ashamed, look down}: Whose blood was it, porter? He wouldn't say.")

[node name="Supper" type="Node" parent="Director" node_paths=PackedStringArray("seat", "seat_duty", "bread", "osric", "thomas", "watcher", "aside_by")]
script = ExtResource("supper_gd")
phase = 0
due = 17.25
watch_late = true
fetcher = &"cole"
duty = "Supper in the refectory, at the supper bell"
seat = NodePath("../../Marks/PorterSeat")
seat_duty = NodePath("../../Duties/SupperSeat")
bread = NodePath("../../Duties/Bread")
osric = NodePath("../../Brothers/Osric")
thomas = NodePath("../../Brothers/Thomas")
watcher = NodePath("../../Brothers/Hugh")
aside_by = NodePath("../../Brothers/Thomas")
seated_lines = PackedStringArray()
serve_lines = PackedStringArray("(Osric sets down your bread and ale, and the extra heel beside them. He smiles, the same smile as every night.)", "Osric {glad}: The heel for the porter. A day's fast, and look at you. Eat up.")
eat_lines = PackedStringArray("(The bread is bitter tonight. The taste stays at the back of your tongue.)")
palm_seen_lines = PackedStringArray("Osric {glad, smile}: (From the hatch, smiling.) Not hungry, porter? I'll keep an eye on you. Can't have you wasting away.")
aside_lines = PackedStringArray("(Thomas leans over, his arm bound, and tilts your face to the candle. He looks into one eye, then the other, for a long time.)", "Thomas {warm}: Eat, Alric. All of it. You'll need your strength tonight.")

