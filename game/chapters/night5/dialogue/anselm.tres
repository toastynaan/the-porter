[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n5_anselm"
text = "# DRAFT
# Anselm at dusk, in his chair in the infirmary (night 5, clear and cold). Frightened. He has something to tell the porter,
# and won't say it here: he can't see who's in the room. At Matins, where the singing covers a voice.
# (At Matins he tells him the key to the crypt passage is in the granary. Nothing here says so.)
== start
(Anselm has turned toward the door before you reach it. His hand comes out and finds your sleeve.)
Anselm: Porter. Closer.
Anselm: There's a thing I should have told you the night you came. Not here. I can't see who's in the room.
-> topics

== again
(His hand finds your sleeve again, and holds it.)
Anselm: Not here, I said. Not here.
-> topics

== topics
* [if not n5_anselm_tell] What do you have to tell me, brother? -> tell
* [if not n5_anselm_heard] What did you hear from the chapter house? -> heard
* [if died_edwin] [if not n5_anselm_edwin] Did you know Edwin well, brother? -> edwin

== tell [set n5_anselm_tell]
Anselm: At Matins. In the church, where the singing covers a man's voice. I'll find you.
(His grip tightens.)
Anselm: Don't come asking again before then. Don't look at me in the choir.
-> topics

== heard [set n5_anselm_heard]
Anselm: A cry. Then feet, after. Not running, boy. Walking.
Anselm: Men who know where they're going walk.
-> topics

== edwin [set n5_anselm_edwin]
Anselm: He read to me on Sundays. Psalms, and badly, and he laughed at his own mistakes.
Anselm: They carried him past this door at Lauds. I knew who it was. Nobody else in this house would have been so light.
-> topics

== leave
Anselm: Matins, porter. Not before.
"
