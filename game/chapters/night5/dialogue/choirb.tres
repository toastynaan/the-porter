[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n5_choirb"
text = "# DRAFT
# Brother Aldo in the nave at dusk (night 5, clear and cold), setting out the psalters. More stalls empty than full.
# Wulfric, killed in the fog (died_fog_brother): Aldo came in a beat behind him at Matins. Simon slept in the next bed:
# dead on the chapter house floor (died_simon), or alive and hiding at the back of the church.
== start
(Brother Aldo in the nave, setting out the psalters. There are more empty stalls than full ones now.)
Aldo {weary}: Porter. I keep setting out too many. I count them, and then I count them again.
-> topics

== again
Aldo {weary}: Still here? Help me count, then.
-> topics

== topics
* [if died_fog_brother] [if not n5_choirb_wulfric] I'm sorry about Brother Wulfric. -> wulfric
* [if not n5_choirb_simon] What of Brother Simon? -> simon

== wulfric [set n5_choirb_wulfric]
Aldo {sad}: Six years I came in a beat behind him at Matins. Last night there was nothing to come in behind.
Aldo {sad, swallow}: I sang it alone, and flat. He'd have hated it.
-> topics

== simon [set n5_choirb_simon]
-> simon_dead [if died_simon]
-> simon_alive

== simon_dead
Aldo {sad}: His bed was next to mine. I've put his blanket over it, so I don't have to see it empty.
-> topics

== simon_alive
Aldo {grave}: He's at the back of the church with his knees drawn up, like a child. He won't come into the choir, or say why.
-> topics

== leave
Aldo {grave}: Count us tonight, porter. Count carefully.
"
