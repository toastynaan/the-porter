tower = NodePath("../../BellTower")
gate = NodePath("../../AbbeyGate")
lines = PackedStringArray("(You wake to rain on the shutter. The light is nearly gone.)", "(The gate stands open in the rain, and Cole stands in it with his hood up.)", "(Your ledger lies open on the desk at last night's page. You shut it before you slept.)")

