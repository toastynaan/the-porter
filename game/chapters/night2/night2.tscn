script = ExtResource("lane_gd")
phase = 2
can_doze = true
duty = "The grille: something in the lane"
hour = 23.25
grate = NodePath("../../Duties/Grate")
death = NodePath("../../LaneDeath")
curfew = NodePath("../../Curfew")
visitors = Array[ExtResource("visitor_gd")]([ExtResource("joan"), ExtResource("roger"), ExtResource("sailor")])
jankin_look = ExtResource("chr_jankin")
cry_lines = PackedStringArray("(A cry from the lane, short, and cut off.)", "(You wait for Gib's call. It doesn't come.)")
death_lines = PackedStringArray("(Under the lantern by the chandler's, a man alone. Behind him stands something tall that wasn't there a moment ago.)", "(A flash at his throat, one cut, and he folds into the gutter. Blood runs dark in the lantern light.)", "(The tall shape stands over him and doesn't move. Not while you're looking.)")
after_lines = PackedStringArray("(Nothing stands in the lane now. The lantern burns on.)")

[node name="Bell" type="Node" parent="Director" node_paths=PackedStringArray("rope", "tower", "hanged")]
script = ExtResource("bell_gd")
phase = 3
due = 24.0
watch_late = true
can_doze = true
duty = "Ring the bell for Matins"
rope = NodePath("../../Duties/BellRope")
tower = NodePath("../../BellTower")
hanged = NodePath("../../Bodies/Bede")
heavy_lines = PackedStringArray("(You take the rope and pull. It doesn't give. It's heavy, as if the bell were full of earth.)", "(Something drops past you out of the dark above and stops short, hard, a hand's breadth from your face.)", "(Brother Bede, turning slowly on a rope from the bell's frame. His feet are bare.)", "(You look at the knot under his ear. A sailor's knot, neat and hard.)")

