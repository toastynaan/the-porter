watcher = NodePath("../../Brothers/Hugh")
aside_by = NodePath("../../Brothers/Thomas")
seated_lines = PackedStringArray()
serve_lines = PackedStringArray("(Osric sets down your bread and ale, and the extra heel again.)", "Osric {glad, smile}: The heel for the porter. I keep it back special.")
eat_lines = PackedStringArray("(Dark and sour. It sits heavy in you.)")
palm_seen_lines = PackedStringArray("Osric {glad}: (From the hatch, smiling.) Not hungry, porter? I'll keep an eye on you. Can't have you wasting away.")
aside_lines = PackedStringArray("Thomas {grave}: (Low, under the reading.) I've seen the prior about the house at night, Alric. Places he has no business being.", "Thomas {grave, nod}: Say nothing. Only keep your eyes open.")
aside_unless = &"n2_thomas_prior"

