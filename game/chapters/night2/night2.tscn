[node name="Night2" instance=ExtResource("base")]
editor_description = "Night 2, the bell (design doc, Night 2): Thomas on the prior about at night, Joan, Roger (if the merchant died) and the sailor at the gate, a death in the lane toward midnight, Bede hanging in the bell tower at Matins, the count one short, an empty bed and a torn page on the round, and at dawn the abbot's demon and the prior's question. It inherits night_base.tscn."

