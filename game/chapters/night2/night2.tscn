tower = NodePath("../../BellTower")
gate_lamp = NodePath("../../Lamps/GateLamp")
lines = PackedStringArray("(Back to the gate. Keep watch from the bench until Lauds. You can doze, if you dare.)")
lauds_lines = PackedStringArray("(The Lauds bell. Grey light comes up over the court.)")

[node name="DawnScene" type="Node" parent="Director" node_paths=PackedStringArray("people", "marks")]
script = ExtResource("scene_gd")
phase = 5
duty = "Lauds: the abbot, in the court"
people = [NodePath("../../Brothers/Godric"), NodePath("../../Brothers/Hugh")]
marks = [NodePath("../../Marks/GodricDawn"), NodePath("../../Marks/HughDawn")]
lines = PackedStringArray("Godric {afraid}: Brothers. A demon has come into this house. Brother Bede is dead of it, and I will not pretend otherwise.", "Godric {grave}: From today, incense at every office, twice the measure, until it is driven out. Pray, and keep together.", "(As the brothers go, the prior's hand closes on your arm and draws you aside.)", "Hugh {cold, jaw}: A word, porter. Where were you in the night? All of it, hour by hour.")
answers = PackedStringArray("At the gate all night, and on my round.", "I rang the bell, and I found Brother Bede.", "(Tell him everything you saw.)")
replies = PackedStringArray("Hugh {cold}: The gate and the round. So everyone was where they should be, and still a brother hangs.", "Hugh {cold, jaw}: You found him. You always seem to be first, porter. I'll remember that.", "Hugh {grave}: (He writes it all on his wax before he speaks.) Tell no one else what you've told me. No one.")
answer_tags = PackedStringArray("set n2_told_hugh=gate", "set n2_told_hugh=round", "set n2_told_hugh=thomas; trust hugh -5")

