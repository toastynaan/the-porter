[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n2_dunstan"
text = "# DRAFT
# Dunstan at the woodpile at dusk (night 2), stacking logs out of the rain. Silent: a look, and no word at all tonight.
== start
(Dunstan at the woodpile, stacking split logs under the eaves out of the rain. He doesn't stop.)
-> topics

== again
(Dunstan doesn't look up.)
-> topics

== topics
* [if not n2_dunstan_help] (Pick up an armful and help him stack.) -> help
* [if died_merchant] [if not n2_dunstan_pond] Were you there when they pulled the merchant out, brother? -> pond

== help [set n2_dunstan_help]
(He watches you set the logs down. Then he lifts them off the pile and stacks them again, his own way.)
-> topics

== pond [set n2_dunstan_pond]
(He looks at you. Then he goes back to the logs.)
-> topics

== leave
(Behind you, the logs go on thudding onto the pile.)
"
