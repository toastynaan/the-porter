[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n2_choira"
text = "# DRAFT
# Brother Wulfric on the south walk at dusk (night 2), rubbing his knees. Background; crabbed.
# The drowned merchant, or the abbot's extra hour of prayer; the abbot has dreamed badly since Michaelmas.
== start
(Old Brother Wulfric on the south walk, rubbing his knees.)
-> dead [if died_merchant]
-> plain

== dead
Wulfric: A drunk drowns in our fishpond, and the abbot goes about with a face like he's seen the Devil.
Wulfric: In my day a drunk who drowned was a drunk who drowned.
-> topics

== plain
Wulfric: The abbot had us on our knees an hour after chapter, praying for the house. My knees are older than his.
-> topics

== again
Wulfric: Still here, boy? Go and ring something.
-> topics

== topics
* [if not n2_choira_abbot] What is the abbot afraid of, brother? -> abbot

== abbot [set n2_choira_abbot]
Wulfric: Bad dreams. He's had them since Michaelmas. At his age you dream of the grave, and he's earned it.
-> end

== leave
Wulfric: On the mark tonight, boy.
"
