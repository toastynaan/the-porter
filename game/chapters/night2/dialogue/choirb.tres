[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/talk/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n2_choirb"
text = "# DRAFT
# Brother Aldo in the nave at dusk (night 2), setting out the psalters in the stalls. Background.
# Bede wasn't at Sext or None; nobody knows yet that he is dead (he's found when the porter rings Matins).
# Aldo thinks he's up the tower sulking. Promising to count him in sets n2_choirb_bede.
== start
(Brother Aldo in the nave, setting out the psalters. At one stall he sets the book down, picks it up, sets it down.)
Aldo {wary}: Have you seen Bede? He wasn't at Sext. Nor at None. The prior marked him.
Aldo {amused}: He'll be up the tower with the rooks, sulking. He goes up there to think.
-> topics

== again
Aldo {wary}: No Bede yet. He'll catch it from the prior.
-> topics

== topics
* [if not n2_choirb_bede] I'll look for him at Matins. -> bede

== bede [set n2_choirb_bede]
Aldo {warm}: Count him in for me, then. Third stall on the left.
-> end

== leave
Aldo {calm}: If you see Bede, tell him the prior's asking.
"
