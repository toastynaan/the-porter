[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n1_choirc"
text = "# DRAFT
# Brother Piers, of the choir, on the east walk at dusk (night 1), watching the rain fill the garden. Background.
== start
(A brother of the choir on the east walk, watching the rain drown the garden beds.)
Piers: They say you're from the country. You'll find London's rain is the same, only dirtier.
-> topics

== again
Piers: Still raining. It always is, in November.
-> topics

== topics
* [if not n1_choirc_house] (Ask what the house is like.) -> house

== house [set n1_choirc_house]
Piers: Quiet. We were thirty once, the old brothers say. Now look at us.
-> end

== leave
Piers: Keep dry, porter.
"
