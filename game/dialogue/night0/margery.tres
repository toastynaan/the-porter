[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n0_margery"
text = "# DRAFT
# Margery, a neighbour, hurrying home with her basket before dark, night 0. Nervous; she won't stop long.
== start
(A woman with a covered basket on her arm, walking fast, her eyes on the cobbles.)
Margery: Can't stop, brother, I'm sorry. Not with the light going.
* (Ask where she's hurrying.) -> home
* (Ask what she's afraid of.) -> afraid
* (Bless her, and let her go.) [trust margery 5] -> bless

== home
Margery: Home, by Saint Andrew's. The long way round.
Margery: Two streets more, but it doesn't go past that wall.
-> end

== afraid
Margery: Afraid? I'm careful, that's all.
(Her eyes go to the abbey wall, and away.)
Margery: I don't walk past that wall after dark. Not for anybody. No offence to your habit.
-> end

== bless
Margery: And you, brother. God keep you. You'll need keeping, over there.
-> end

== again
Margery: Brother, I said I can't stop!
(She's already past you.)
-> end

== leave
Margery: God keep you!
"
