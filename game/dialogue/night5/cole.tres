[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n5_cole"
text = "# DRAFT
# Cole at dusk, keeping the gate (night 5, clear and cold). Lay brothers don't talk (Look and Feel, \"Characters\").
== start
(Cole in the open gateway, arms folded. The lane is clear and cold behind him, every lantern sharp. He says nothing.)
* Did you hear the cry from the chapter house? -> nothing
* I'll take the gate after supper. -> nothing
* Good evening, Brother Cole. -> end

== again
(Cole looks at you, then back at the lane. He says nothing.)
-> end

== nothing
(He says nothing. His hands, folded on his arms, are scrubbed red to the wrist.)
-> end
"
