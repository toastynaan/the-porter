[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n5_choirc"
text = "# DRAFT
# Brother Piers on the east walk at dusk (night 5, clear and cold), looking at the chapter house door. Background; dry.
# What the brothers say now (and what some say quietly), and whether he'll leave: he has nowhere to go.
== start
(Brother Piers on the east walk, his breath smoking in the cold. He's looking at the chapter house door.)
Piers: Clear tonight. You can see every star. I'd sooner have the fog back.
-> topics

== again
Piers: Still cold.
-> topics

== topics
* [if not n5_choirc_talk] (Ask what the brothers are saying.) -> talk
* [if not n5_choirc_leave] (Ask if he'll leave the abbey.) -> go

== talk [set n5_choirc_talk]
Piers: That it took the boy first because he was the youngest. That it walks in the fog. That it's no demon at all.
(He looks at you.)
Piers: Nobody says that last one loudly.
-> topics

== go [set n5_choirc_leave]
Piers: And go where? I've been in this house since I was nine. Outside that gate I'm a shaved head and no trade.
Piers: I'll stay. I'll keep a candle lit.
-> topics

== leave
Piers: Keep warm, porter.
"
