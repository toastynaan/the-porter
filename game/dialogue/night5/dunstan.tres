[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n5_dunstan"
text = "# DRAFT
# Dunstan at dusk, by the woodpile (night 5, clear and cold). Lay brothers don't talk (Look and Feel, \"Characters\").
== start
(Dunstan is at the woodpile. The axe comes down, and down. He doesn't stop for you, and he says nothing.)
* Did you hear the cry from the chapter house? -> nothing
* Have you seen anyone about, brother? -> nothing
* Good night, Brother Dunstan. -> end

== again
(Dunstan looks up from the block. He says nothing.)
-> end

== nothing
(He says nothing. He sets a log on the block, and the axe comes down.)
-> end
"
