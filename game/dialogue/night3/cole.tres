[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n3_cole"
text = "# Cole at dusk, keeping the gate (night 3). Lay brothers don't talk (Look and Feel, \"Characters\").
== start
(Cole looks at you and says nothing. He keeps the gate by day.)
* (Ask if anyone came to the gate today.) -> nothing
* (Say you'll take the gate after supper.) -> nothing
* (Wish him good evening.) -> end

== again
(Cole says nothing.)
-> end

== nothing
(He says nothing.)
-> end
"
