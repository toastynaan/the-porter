[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n3_cole"
text = "# DRAFT
# Cole at dusk, keeping the gate (night 3). Lay brothers don't talk (Look and Feel, \"Characters\").
== start
(Cole stands in the open gateway, arms folded, watching the lane. He looks round at you and says nothing.)
* Did anyone come to the gate today, Brother Cole? -> nothing
* I'll take the gate after supper, brother. -> nothing
* Good evening, Brother Cole. -> end

== again
(Cole looks at you, then back at the lane. He says nothing.)
-> end

== nothing
(He says nothing. He looks at you a moment longer than he needs to, then back at the lane.)
-> end
"
