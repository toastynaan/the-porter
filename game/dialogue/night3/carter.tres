[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n3_carter"
text = "# DRAFT
# The carter in the lane at dusk (night 3), walking his empty wagon home before dark. A line or two, and he's gone.
# Night 3 keeps its own; the other nights are game/dialogue/lane/carter.tres.
== start
(The carter, walking at his horse's head, the wagon rattling empty behind him.)
Carter: Porter. I can't stop. I want to be out through Aldgate before they shut it.
* How's the lane tonight? -> lane
* Have you seen any pilgrims on the road? -> pilgrims
* Good night. Go carefully. -> end

== lane
Carter: Quiet as a church. Quieter than your church, by what they say.
Carter: Hob's doing no trade. Nobody wants to drink with your wall looking at them.
-> end

== pilgrims
Carter: Not one, all day, from Mile End in. Last week I'd pass a dozen, with their staffs and their badges.
Carter: Word gets about, porter. Folk would sooner walk to Canterbury.
-> end
"
