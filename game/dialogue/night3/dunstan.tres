[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n3_dunstan"
text = "# DRAFT
# Dunstan at dusk, by the woodpile (night 3). Lay brothers don't talk (Look and Feel, \"Characters\").
== start
(Dunstan rests his axe on the block and looks at you. He says nothing.)
* (Ask about the woodpile.) -> nothing
* (Ask if he has seen anything.) -> nothing
* (Wish him good night.) -> end

== again
(Dunstan looks up from the woodpile. He says nothing.)
-> end

== nothing
(He says nothing. He sets a log on the block, and the axe comes down.)
-> end
"
