[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://game/dialogue/conversation.gd" id="1_convo"]

[resource]
script = ExtResource("1_convo")
id = &"n3_osric"
text = "# Osric at dusk, in the kitchen (night 3). Placeholder lines in the design doc's words.
== start
Osric: (Placeholder: Osric, the cellarer, jolly, busy at the kitchen fire. He greets you.)
-> topics

== again
Osric: (Placeholder: Osric, still at the fire.)
-> topics

== topics
* [if not n3_osric_bread] (Ask about the bread.) -> bread
* [if not n3_osric_supper] (Ask what is for supper.) -> supper
* [if not n3_osric_page] (Ask about the page torn from the ledger.) -> page

== bread [set n3_osric_bread]
Osric: (Placeholder: he laughs, and promises you extra bread.)
-> topics

== supper [set n3_osric_supper]
Osric: (Placeholder: Osric on tonight's supper.)
-> topics

# Asking the wrong brother the wrong question: Suspicion +5 (design doc).
== page [set n3_osric_page] [suspicion 5]
Osric: (Placeholder: Osric's answer about the missing page.)
-> topics

== leave
Osric: (Placeholder: he calls after you not to be late for supper.)
"
