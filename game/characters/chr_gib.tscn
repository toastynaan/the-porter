[node name="Gib" type="Node3D"]
editor_description = "Gib, the night watchman: old, hunched; he lights the lane's lanterns and walks it after curfew calling the hour. A grey cloak with its hood down over a grey tunic, a cap, a white beard, a staff in his left hand (his lantern is the visitor's) (tools/build/chr_gib.py). Model is his body on its skeleton, with his clips (PersonModel). Feet at the origin, facing -Z. Head is his face (a FaceRig over the head model); Face is where the conversation camera looks. In the game both ride on the skeleton's head."
script = ExtResource("person_gd")
left_hand_holds = NodePath("Staff")

