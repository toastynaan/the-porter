[node name="Agnes" type="Node3D"]
editor_description = "Agnes, Hob's wife, who keeps the Cross Keys with him: sharp, motherly. A dark wool kirtle and an apron, a wimple and veil, a cloth over her shoulder for the tables (tools/build/chr_agnes.py). Model is her body on its skeleton, with her clips (PersonModel). Feet at the origin, facing -Z. Head is her face (a FaceRig over the head model); Face is where the conversation camera looks. In the game both ride on the skeleton's head."
script = ExtResource("person_gd")

