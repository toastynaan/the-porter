[node name="Carter" type="Node3D"]
editor_description = "Hamo, the carter who drives night 0's wagon. A hood with its shoulder cape, a russet tunic, bound legs, a whip (tools/build/chr_carter.py). Model is his body on its skeleton, with his clips: idle, talk, walk, and seated on the wagon's board driving, the reins out to the horse (sit), when `seated` is on, or the Look's `seated` (PersonModel). Feet (or seat) at the origin, facing -Z. Head is his face (a FaceRig over the head model); Face is where the conversation camera looks. In the game both ride on the skeleton's head."
script = ExtResource("person_gd")

