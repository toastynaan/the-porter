[node name="Mab" type="Node3D"]
editor_description = "Mab, a leper, who begs at the abbey gate every night (Look and Feel, 'Characters': small, wrapped in rags; face covered by cloth; a leper's clapper). Bent; rags to the shin and a ragged shawl, her head and face wound in cloth to the eyes, bound feet, the clapper in her hand (tools/build/chr_mab.py). Model is her body on its skeleton, with her clips (PersonModel). Feet at the origin, facing -Z. Head is her face (a FaceRig over the head model); Face is where the conversation camera looks. In the game both ride on the skeleton's head."
script = ExtResource("person_gd")

