[node name="Warden" type="Node3D"]
editor_description = "Lambert, the warden at Aldgate, night 0's road in: solid, a dark cloak thrown back off his right shoulder over a leather jerkin, a felt cap, a grizzled beard, a tall staff in his left hand (tools/build/chr_warden.py). Model is his body on its skeleton, with his clips: idle, talk, walk (PersonModel). Lantern hangs from his right hand and Staff stands in his left, each with its origin where the hand holds it: move one (the ride lifts the lantern to the porter's face) and his arm follows it, or brings it back into his hand if it is out of reach (right_hand_holds, left_hand_holds). Feet at the origin, facing -Z. Head is his face (a FaceRig over the head model); Face is where the conversation camera looks. In the game both ride on the skeleton's head."
script = ExtResource("person_gd")
right_hand_holds = NodePath("Lantern")
left_hand_holds = NodePath("Staff")

