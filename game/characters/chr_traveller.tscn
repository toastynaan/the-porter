[node name="Traveller" type="Node3D"]
editor_description = "Will Fuller, the traveller on the carter's wagon on the road in through Aldgate (night 0): a wool merchant from Colchester, forty-one, lean, road-worn. A felt hat turned up behind, a belted gown under a good travelling cloak, a pack on his back (tools/build/chr_traveller.py). Model is his body on its skeleton, with his clips: idle, talk, walk, and seated on the wagon's bed, knees up (sit, sit_talk) when `seated` is on, or the Look's `seated` (PersonModel). Feet (or seat) at the origin, facing -Z. Head is his face (a FaceRig over the head model); Face is where the conversation camera looks. In the game both ride on the skeleton's head."
script = ExtResource("person_gd")

