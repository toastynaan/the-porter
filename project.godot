; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Porter"
run/main_scene="res://game/render/main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://game/autoload/settings.gd"
GameState="*res://game/autoload/game_state.gd"
TimeDirector="*res://game/ragdoll/time_director.gd"
Talk="*res://game/dialogue/talk.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

