[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="characters"
3d_render/layer_3="fx"
3d_physics/layer_1="world"
3d_physics/layer_2="destructible"
3d_physics/layer_3="capsule"
3d_physics/layer_4="ragdoll"
3d_physics/layer_5="hitbox"
3d_physics/layer_6="hurtbox"
3d_physics/layer_7="debris"
3d_physics/layer_8="debris_small"
3d_physics/layer_9="dead_body"
3d_physics/layer_10="door"
3d_physics/layer_11="interact"

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/physics_engine="Jolt Physics"

[rendering]

environment/defaults/default_clear_color=Color(0.043, 0.047, 0.063, 1)

[shader_globals]

psx_snap={
"type": "float",
"value": 1.5
}
psx_cam_fy={
"type": "float",
"value": 0.0
}
psx_resolution={
"type": "vec2",
"value": Vector2(960, 540)
}
